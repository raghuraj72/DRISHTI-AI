# ============================================================
# DRISHTI-AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── DATABASE ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=drishti_db
POSTGRES_USER=drishti
POSTGRES_PASSWORD=drishti_secure_pass_change_me
DATABASE_URL=postgresql+asyncpg://drishti:drishti_secure_pass_change_me@localhost:5432/drishti_db

# ── KAFKA ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=drishti-consumer-group

# ── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OPENSKY NETWORK (ADS-B Air Traffic) ─────────────────────
# Register free at: https://opensky-network.org/index.php?option=com_users&view=registration
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# ── AISSTREAM.IO (Maritime AIS) ──────────────────────────────
# Register free at: https://aisstream.io/authenticate
AISSTREAM_API_KEY=your_aisstream_api_key_here

# ── ESA SENTINEL HUB (Satellite Imagery) ────────────────────
# Register free at: https://dataspace.copernicus.eu/
# Create OAuth2 client at: https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret
SENTINEL_INSTANCE_ID=your_sentinel_instance_id

# ── ISRO BHUVAN (Indian Satellite Data) ─────────────────────
# Access via: https://bhuvan.nrsc.gov.in/
# No auth required for public WMS layers
BHUVAN_BASE_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms

# ── USGS SEISMIC (No auth required) ─────────────────────────
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# ── GOOGLE GEMINI API (Situation Reports) ───────────────────
# Get API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── MAPBOX (Dashboard Map) ───────────────────────────────────
# Get public token at: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# ── MLFLOW (Model Tracking) ──────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=drishti-ai-detection

# ── LOCAL STORAGE ───────────────────────────────────────────
DATA_DIR=./data
SATELLITE_DATA_DIR=./data/satellite
MODEL_DIR=./detection/models

# ── APPLICATION ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── ALERT THRESHOLDS ────────────────────────────────────────
THREAT_SCORE_CRITICAL=0.9
THREAT_SCORE_HIGH=0.7
THREAT_SCORE_MEDIUM=0.5
THREAT_SCORE_LOW=0.3

# ── POLLING INTERVALS (seconds) ─────────────────────────────
OPENSKY_POLL_INTERVAL=30
SEISMIC_POLL_INTERVAL=300
SATELLITE_FETCH_INTERVAL=3600
